# Copy to .env for local development. Never commit .env.
# Production values live in Vercel → Project → Settings → Environment Variables.

# ---- Database (Supabase Postgres in production) ----
# Runtime connection. On Supabase use the pooled "Transaction" connection string (port 6543).
DATABASE_URL="postgresql://shabari@127.0.0.1:54329/sws_dev"
# Migrations need a direct (non-pooled) connection. On Supabase use the "Direct" or "Session" string (port 5432).
DIRECT_URL="postgresql://shabari@127.0.0.1:54329/sws_dev"

# ---- Site ----
# Canonical origin used for metadata, sitemap and redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public contact address shown on the site. Keep the MIT address until hello@studywithshabari.com is verified.
NEXT_PUBLIC_CONTACT_EMAIL="jshankar@mit.edu"

# ---- Sessions ----
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used to HMAC rate-limit keys.
AUTH_SECRET=""

# ---- Booking (Calendly) ----
# Your 15-minute event link, e.g. https://calendly.com/your-name/15min. Leave empty to show the email fallback.
NEXT_PUBLIC_CALENDLY_URL=""

# ---- Email (IONOS SMTP once a mailbox exists) ----
# Nothing is sent until MAIL_SENDER_VERIFIED is "true". Until then messages are recorded with status NOT_CONFIGURED.
SMTP_HOST=""          # smtp.ionos.com
SMTP_PORT="587"
SMTP_USER=""          # the full mailbox address
SMTP_PASSWORD=""
MAIL_FROM=""          # "Study with Shabari <hello@studywithshabari.com>"
MAIL_SENDER_VERIFIED="false"
# Where new-inquiry notifications go.
ADMIN_NOTIFY_EMAIL="jshankar@mit.edu"

# ---- File storage (Supabase Storage) ----
# Leave empty locally: uploads are written to .local/uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""   # server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_STORAGE_BUCKET="diagrams"

# ---- Monitoring (Sentry, optional) ----
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""   # only for source-map upload in CI/Vercel builds
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Chat assistant ----
# See docs/IONOS.md before enabling anything here.
NEXT_PUBLIC_CHAT_WIDGET_SRC=""
